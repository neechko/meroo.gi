@"
# Folder & file catatan lokal
backup/
plan.txt

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Monorepo Cache
node_modules/
.pnpm-store/
.turbo/

# Build Web
dist/
dist-ssr/
*.local

# React Native & Expo
.expo/
web-build/
apps/mobile/android/
apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Environment Variables (JANGAN PERNAH COMMIT)
.env
.env.*
*.env
!.env.example

# Supabase temp & local
supabase/.temp/
.branches

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*bug/
*.njsproj
*.sln
*.sw?
"@ | Set-Content -Path .\.gitignore -Encoding UTF8

# Hapus .gitignore lama di dalam apps/web agar aturan Git terpusat di root
Remove-Item -Path .\apps\web\.gitignore -Force -ErrorAction SilentlyContinue

# Bersihkan file temp supabase dari tracking Git jika masih ter-cache
git rm -r --cached apps/web/supabase/.temp 2>$null
git add -A
**/.temp/
